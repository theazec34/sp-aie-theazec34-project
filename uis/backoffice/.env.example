# Por defecto el backoffice usa /api-backend (rewrite → INTERNAL_API_URL).
# Solo hace falta DIRECT + estas URLs si quieres llamar a :8000 sin proxy.
# NEXT_PUBLIC_API_DIRECT=1
NEXT_PUBLIC_API_URL=http://localhost:8000
# Alias del enunciado del hito inventario (misma API FastAPI)
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000
# INTERNAL_API_URL=http://127.0.0.1:8000
# Telemetry batch sink (opcional; por defecto /api-backend/telemetry/events)
# NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
