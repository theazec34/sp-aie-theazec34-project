{
  "name": "sp-aie-theazec34-project",
  "version": "0.1.0",
  "private": true,
  "description": "Brasaland Digital — monorepo (website, backoffice, FastAPI)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "demo": "npm run build && node dist/demo.js",
    "dev:website": "npm run dev --prefix uis/website",
    "dev:backoffice": "npm run dev --prefix uis/backoffice",
    "dev:api": "cd services/api && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:api": "cd services/api && uv run pytest -q"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "typescript": "^5.7.0"
  }
}
