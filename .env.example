# Brasaland Digital — variables para docker compose (raíz del monorepo)
# Copia a `.env` y rellena secretos. NUNCA subas `.env` a GitHub.

# --- Backend (FastAPI / services/api) ---
SECRET_KEY=dev-brasaland-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
RESET_TOKEN_EXPIRE_MINUTES=30

# Enlace de reset de contraseña → backoffice en el host (puerto 3001 en Docker)
FRONTEND_URL=http://localhost:3001

# Resend (opcional). Vacío = enlace en logs de uvicorn.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Brasaland OPS <onboarding@resend.dev>

# Supabase / Postgres (Transaction pooler URI). Vacío = SQLite en el volumen del backend.
DATABASE_URL=

# --- Frontends (browser en el host → usa localhost, NO el nombre Docker) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# --- Solo documentación / llamadas server-to-server dentro de la red Docker ---
# El navegador NO puede resolver este host; usar localhost arriba.
INTERNAL_API_URL=http://backend:8000
