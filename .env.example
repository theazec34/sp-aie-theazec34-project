# Brasaland Digital — variables para docker compose (raíz del monorepo)
# Copia a `.env` y rellena secretos. NUNCA subas `.env` a GitHub.

# --- Backend (FastAPI / services/api) ---
SECRET_KEY=dev-brasaland-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
RESET_TOKEN_EXPIRE_MINUTES=30

# Seed admin (OBLIGATORIO en prod — nunca commits de passwords reales)
# Usar un email con TLD real (pydantic/email-validator rechaza .local / .test)
SEED_ADMIN_EMAIL=admin@brasaland.com
SEED_ADMIN_PASSWORD=ChangeMeLocalOnly12!
SEED_ADMIN_NAME=Admin Brasaland

# Flower basic auth (solo loopback en compose)
FLOWER_BASIC_AUTH=ops:change-me-flower

# Rate limit endpoints LLM (NIST Protect)
AGENT_RATE_LIMIT_MAX=20
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
KNOWLEDGE_RATE_LIMIT_MAX=30
KNOWLEDGE_RATE_LIMIT_WINDOW_SECONDS=60

# Enlace de reset de contraseña → backoffice en el host (puerto 3001 en Docker)
FRONTEND_URL=http://localhost:3001

# Resend (opcional). Vacío = enlace en logs de uvicorn.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Brasaland OPS <onboarding@resend.dev>

# Supabase / Postgres (Transaction pooler URI). Vacío = SQLite en el volumen del backend.
DATABASE_URL=

# --- Frontends (browser en el host → usa localhost, NO el nombre Docker) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000
# Website forms usan /api-backend (rewrite). Solo si quieres URL directa:
# NEXT_PUBLIC_API_DIRECT=1
# En Docker Compose, interfaces usa host.docker.internal:8000 (forzado en compose)

# Telemetry intake stub (backoffice batches)
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# --- Qdrant / RAG (Hito 7) ---
# Con Docker Compose el backend redefine QDRANT_URL=http://qdrant:6333
QDRANT_URL=
QDRANT_COLLECTION=brasaland_knowledge
# Sin URL: cliente embebido en .qdrant_storage/ (dev sin Docker)
# QDRANT_PATH=.qdrant_storage
RAG_TOP_K=5
RAG_MIN_SCORE=0.32

# Embeddings — modelo dedicado (NUNCA reutilizar el de generación)
# Codespaces sin egress a HuggingFace: usa hash (offline, demo).
# Con red: fastembed (mejor calidad semántica).
EMBEDDING_PROVIDER=hash
# EMBEDDING_PROVIDER=fastembed
# FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Portal 4Geeks (OpenAI-compatible), ejemplo:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://<tu-gateway-4geeks>
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL_ID=downtown-miami/openrouter/perplexity/pplx-embed-v1-0.6b

# Generación — chat/completion distinto del embedding
# Sin credenciales: grounded (solo texto recuperado). Producción: openai + portal.
GENERATION_PROVIDER=grounded
# GENERATION_PROVIDER=openai
# GENERATION_BASE_URL=https://llm.4geeks.ai/v1
# GENERATION_API_KEY=
# GENERATION_MODEL_ID=madrid-spain/opnerouter/openai/gpt-6-luna
#
# Alias aceptados (mismo efecto que GENERATION_*):
# LLM_BASE_URL=https://llm.4geeks.ai/v1
# LLM_API_KEY=
# LLM_MODEL=madrid-spain/opnerouter/openai/gpt-6-luna
# LLM_TIMEOUT_SECONDS=60

# --- Celery / Redis (DEV-55) ---
# Docker Compose fuerza redis://redis:6379/0 en los servicios.
# Sin Docker en local: redis://127.0.0.1:6379/0
REDIS_URL=redis://redis:6379/0
CELERY_SOFT_TIME_LIMIT=120
CELERY_TIME_LIMIT=180

# --- Solo documentación / llamadas server-to-server dentro de la red Docker ---
# El navegador NO puede resolver este host; usar localhost arriba.
# Compose fuerza host.docker.internal en interfaces (backend:8000 hace TIMEOUT en Codespaces).
INTERNAL_API_URL=http://host.docker.internal:8000
